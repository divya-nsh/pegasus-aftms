{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "bin": "./dist/index.js",
  "imports": {
    "#/*": "./dist/*"
  },
  "private": true,
  "pkg": {
    "assets": [
      "node_modules/drizzle-orm/**/*",
      "client-dist/**/*",
      "dist/client-dist/**/*",
      "public/**/*",
      "migrations/**/*"
    ]
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "tsx watch ./src/index.ts",
    "build": "rm -rf dist && node esbuild.config.mjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "pkg": "pnpm build && tsx pkg.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mime-types": "^3.0.1",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.1",
    "@yao-pkg/pkg": "^6.23.0",
    "drizzle-kit": "1.0.0-rc.4",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@repo/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "@types/pg": "^8.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonc-parser": "^3.3.1",
    "mime-types": "^3.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nanoid": "^6.0.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "migrations",
    "public",
    "client-dist",
    "start.cmd"
  ]
}
